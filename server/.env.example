PORT=4000
# Same sandbox publishable key as the mobile app (pk_…). Used to verify Relai sessions via GET /me.
RELAI_PUBLISHABLE_KEY=pk_sandbox_your_key_here
# Server-only Relai secret (sk_…). Used to poll order status for trusted escrow release.
# Never put this in mobile/web clients.
RELAI_SECRET_KEY=sk_sandbox_your_key_here
# Relai webhook signing secret from the portal. Endpoint: POST /api/relai/webhooks
RELAI_WEBHOOK_SECRET=whsec_relai_your_secret_here
# Set true only in local/dev if you want POST /api/admin/reseed
ALLOW_RESEED=true
# Grant the `admin` marketplace role (not self-serve). Comma-separated Relai
# user ids and/or emails. Admins resolve disputes and approve escrow actions.
ADMIN_USER_IDS=
ADMIN_EMAILS=
# Optional machine key for scripts/cron (x-admin-key). In-app ops use admin role.
ADMIN_API_KEY=

# Commerce toggle. false = food pantry / free swap (no Stripe, hide prices in clients).
# true (default) still requires STRIPE_SECRET_KEY below to actually charge.
PAYMENTS_ENABLED=true

# Stripe escrow (authorize on buy, capture + transfer on pickup).
# Leave unset or set PAYMENTS_ENABLED=false for a non-monetary marketplace.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Platform fee in basis points (1000 = 10%). Seller receives the rest on pickup.
STRIPE_PLATFORM_FEE_BPS=1000
# Used for Stripe Connect onboarding return/refresh URLs (web Account page).
APP_BASE_URL=http://localhost:3000
# Webhook signing secret from Dashboard or `stripe listen`.
# Forward: stripe listen --forward-to localhost:4000/api/payments/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# After buy: if seller never accepts, void the authorization.
SELLER_ACCEPT_HOURS=24
# After accept: if seller never drops off, void the authorization.
SELLER_DROP_OFF_HOURS=48
# After drop-off: if buyer never picks up, auto-release escrow to seller.
# Uses the earlier of Relai pickup-link expiry and this many hours (capped at 144).
PICKUP_NO_SHOW_HOURS=72
# How often to scan for seller timeouts, no-shows, and stuck transfers (ms).
ESCROW_SWEEP_INTERVAL_MS=60000
