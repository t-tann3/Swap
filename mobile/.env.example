# Sandbox publishable key from the Relai portal (pk_sandbox_…).
# Copy this file to .env and paste your key. Never put an sk_ key here.
RELAI_PUBLISHABLE_KEY=pk_sandbox_your_key_here

# Node marketplace API (iOS Simulator can use localhost)
API_BASE_URL=http://localhost:4000

# Stripe publishable key is loaded from the API (/api/payments/config).
# Configure STRIPE_* on the server; never put sk_ keys in the mobile app.
