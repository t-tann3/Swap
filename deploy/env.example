# Copy to repo root as `.env` for docker compose (not server/.env).
#   cp deploy/env.example .env

# Public hostnames (DNS A records → Droplet IP). No https:// prefix.
API_HOST=api.yourdomain.com
APP_HOST=app.yourdomain.com

# Baked into the Next.js image at build time
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_RELAI_PUBLISHABLE_KEY=pk_sandbox_your_key_here
